{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for MKMN",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://**" }, { "url": "https://**" }]
    },
    "fs:deny-default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "dialog:default",
    "notification:default"
  ]
}
